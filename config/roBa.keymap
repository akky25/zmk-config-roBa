#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
    require-prior-idle-ms = <150>;
};

&trackball {
    // オートマウスは roBa_R.overlay の zip_temp_layer で行う
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <18 19>;
            layers = <4>;
        };

        mb2_2 {
            bindings = <&mkp MB2>;
            key-positions = <31 30>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // AltTab: Cmd を押したまま Tab（Cmd は Space を離すまで保持）
        sw_start: sw_start {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp TAB>;
        };

        // Space 長押し: レイヤー2、離したらレイヤー解除と同時に Cmd を離して確定
        num_hold: num_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 2>
                , <&macro_pause_for_release>
                , <&macro_release &mo 2 &kp LGUI>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        h_del: h_del {
            compatible = "zmk,behavior-mod-morph";
            label = "H_DELETE";
            #binding-cells = <0>;
            bindings = <&kp H>, <&kp BACKSPACE>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        // AltTab: Cmd が押されていなければ開始、押されていれば次へ
        sw_next: sw_next {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sw_start>, <&kp TAB>;

            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        // マウスレイヤー: Cmd 押下中は F / L を文字として送る（Cmd+F / Cmd+L 用）
        mb1_or_f: mb1_or_f {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp MB1>, <&kp F>;

            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        mb3_or_l: mb3_or_l {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp MB3>, <&kp L>;

            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        // &lt 2 SPACE と同じ判定で、長押しは num_hold
        lt_num: lt_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&num_hold>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R      &kp T                                                            &kp Y            &kp U  &kp I                &kp O              &kp P
&mt LCTRL A       &kp S         &lt 5 D       &kp F      &kp G        &trans                      &kp C_BRIGHTNESS_INC    &h_del           &kp J  &lt 5 K              &kp L              &kp ENTER
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V      &kp B        &lt 6 COLON                 &kp C_BRIGHTNESS_DEC    &kp N            &kp M  &mt RIGHT_WIN COMMA  &mt RIGHT_ALT DOT  &mt RIGHT_SHIFT SLASH
&kp LA(LEFT_WIN)  &kp LEFT_ALT  &kp LEFT_WIN  &kp LCTRL  &lt_num 0 SPACE  &lt_to_layer_0 1 LANG2      &lt_to_layer_0 1 LANG1  &lt 3 BACKSPACE                                                 &kp A
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        layer_9 {
            bindings = <
&kp N1          &kp N2  &kp N3  &kp N4  &kp N5                      &kp N6     &kp N7   &kp N8   &kp N9  &kp N0
&kp F1          &kp F2  &kp F3  &kp F4  &kp F5  &trans      &trans  &kp F6     &kp F7   &kp F8   &kp F9  &kp F10
&kp LEFT_SHIFT  &trans  &trans  &trans  &kp E   &trans      &trans  &kp GLOBE  &kp F11  &kp F12  &trans  &kp RIGHT_SHIFT
&trans          &trans  &trans  &trans  &trans  &trans      &trans  &trans                               &trans
            >;
        };

        NUM {
            bindings = <
&kp ESC    &trans  &trans  &trans  &trans                      &trans         &kp MINUS  &kp EQUAL      &kp BSLH       &kp GRAVE
&kp TAB    &trans  &kp LSHIFT  &sw_next  &trans  &trans      &trans  &kp BACKSPACE  &trans     &kp LBKT       &kp RBKT       &kp SEMI
&kp LSHFT  &trans  &trans  &trans  &trans  &trans      &trans  &trans         &trans     &kp RIGHT_WIN  &kp RIGHT_ALT  &mt RIGHT_SHIFT SQT
&trans     &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &kp LS(LG(LEFT_ARROW))  &kp LS(LG(DOWN))  &kp LS(LG(UP_ARROW))  &kp LS(LG(RIGHT_ARROW))  &kp HOME
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &kp LEFT_ARROW          &kp DOWN          &kp UP                &kp RIGHT                &kp END
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &kp LA(LG(LEFT_ARROW))  &kp LA(LG(DOWN))  &kp LA(LG(UP_ARROW))  &kp LA(LG(RIGHT_ARROW))  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans    &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &mb1_or_f  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mb3_or_l  &trans
&trans  &trans  &trans  &trans    &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB4  &trans
&trans  &trans  &trans  &trans    &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        FUNCTION_bk {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                      &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        NUM_bk {
            bindings = <
&kp NUMBER_1  &kp N2  &kp N3  &kp N4  &kp N5                      &kp N6     &kp N7     &kp N8    &kp N9     &kp N0
&kp LC(TAB)   &trans  &trans  &trans  &trans  &trans      &trans  &kp MINUS  &kp EQUAL  &kp BSLH  &kp GRAVE  &kp SEMI
&trans        &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &kp LBKT  &kp RBKT   &mt RIGHT_SHIFT SQT
&trans        &trans  &trans  &trans  &trans  &trans      &trans  &trans                                     &trans
            >;
        };
    };
};
